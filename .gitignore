# PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# Spyder
.spyderproject
.spyproject

# Jupyter
.ipynb_checkpoints/

# ========== Sistema Operativo ==========
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ========== Node.js (si usas frontend) ==========
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ========== Docker ==========
*.log
docker-compose.override.yml

# ========== Otros ==========
# Archivos de respaldo
*.bak
*.swp
*.swo
*~

# Archivos temporales
tmp/
temp/
*.tmp

# Archivos comprimidos (opcional)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Configuraciones secretas
secrets.json
*.pem
*.key
.secrets/

# ========== Permitir estos archivos importantes ==========
# Requirements
!requirements.txt
!requirements-dev.txt
!requirements-prod.txt

# README y documentación
!docs/README1.md
!CONTRIBUTING.md
!LICENSE

# Configuración de ejemplo
!.env.example
!settings.example.py

# GitHub Actions / CI/CD
!.github/
!.gitlab-ci.yml
!Dockerfile
!docker-compose.yml

# Mantener estructura de carpetas vacías
!.gitkeep
