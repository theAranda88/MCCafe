*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ========== Django Específico ==========
# Base de datos
*.sqlite3
db.sqlite3

# Archivos estáticos recolectados
/staticfiles/
/static_root/
/static/

# Archivos de media
/media/
/mediafiles/

# Configuración local
local_settings.py
.env
.env.local
.env.*.local

# Migraciones (opcional - algunas personas las comitean)
# */migrations/*.py
# !*/migrations/__init__.py

# ========== Machine Learning ==========
# Modelos entrenados (.pkl, .joblib, .h5, etc.)
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pb

# Datos (datasets)
*.csv
*.tsv
*.xlsx
*.xls
*.json
*.parquet

# Excepciones: permitir archivos de ejemplo pequeños
!**/example_data/*.csv
!**/sample_data/*.csv

# Carpetas de datos
/data/
/datasets/
/raw_data/
/processed_data/

# Carpetas de modelos
/ml_models/*.pkl
/ml_models/*.joblib
/models/*.pkl
/models/*.joblib

# Tensorboard logs
/logs/
/tb_logs/
/tensorboard/

# Weights & Biases
wandb/

# MLflow
mlruns/

# Checkpoints
/checkpoints/
*.ckpt

